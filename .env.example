# Copia este archivo como .env y ajusta los valores.
# El archivo .env nunca se sube a Git.

APP_NAME=JARVIS
# development | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Servidor de la API (0.0.0.0 para la red local, Etapa 10)
API_HOST=127.0.0.1
API_PORT=8000

# Ollama (escucha sólo en este PC)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Modelo creado desde ollama/Modelfile (personalidad de JARVIS)
OLLAMA_CHAT_MODEL=jarvis:base
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_ON_GPU=false
# Rendimiento: hilos de CPU para embeddings y cuánto tiempo queda cargado bge-m3
OLLAMA_EMBED_THREADS=4
OLLAMA_EMBED_KEEP_ALIVE=2m

# RAG: buscar en los documentos antes de responder
RAG_ENABLED=true
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.5
RAG_MIN_SIMILARITY_WITH_KEYWORDS=0.42
# Por voz se lee menos contexto para responder antes
RAG_VOICE_CONTEXT_TOKENS=1100

# Voz a texto (faster-whisper en CPU). tiny/base son más rápidos pero se equivocan más.
STT_MODEL=small
STT_LANGUAGE=es
STT_THREADS=4
# Segundos sin uso antes de liberar la RAM del modelo
STT_IDLE_UNLOAD_SECONDS=300

# Texto a voz (Piper). Voces: python -m scripts.download_tts_voices
TTS_VOICE=es_ES-davefx-medium
# Velocidad: 1.0 normal, 1.15 más pausado, 0.9 más rápido
TTS_LENGTH_SCALE=1.0

# Ingesta de conocimiento: false = JARVIS no descarga nada de internet
INGESTION_ALLOW_INTERNET=true
UPLOADS_DIR=data/uploads

# Usuario por defecto hasta que exista el inicio de sesión (Etapa 10)
DEFAULT_USERNAME=dueno

# PostgreSQL + pgvector (docker compose)
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=jarvis
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
