# Copia este archivo como .env y ajusta los valores.
# El archivo .env nunca se sube a Git.

APP_NAME=JARVIS
# development | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Servidor de la API (0.0.0.0 para la red local, Etapa 10)
API_HOST=127.0.0.1
API_PORT=8000

# Ollama (escucha sólo en este PC)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Modelo creado desde ollama/Modelfile (personalidad de JARVIS)
OLLAMA_CHAT_MODEL=jarvis:base
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT_SECONDS=120

# Usuario por defecto hasta que exista el inicio de sesión (Etapa 10)
DEFAULT_USERNAME=dueno

# PostgreSQL + pgvector (docker compose)
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=jarvis
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
